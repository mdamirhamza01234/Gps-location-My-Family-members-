rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Family members ki location: families/{familyCode}/members/{phone}
    // App anonymous sign-in karta hai, isliye request.auth != null.
    match /families/{familyCode}/members/{phone} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'accuracy', 'updatedAt']);
      allow delete: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
